# GEBRID — contracts/.env.example
# Copy to contracts/.env and fill in. `.env` is gitignored (invariant I-P6).
# This file records NAMES ONLY. Never put a real value here.

# --- Identity of the deployment admin (holds DEFAULT_ADMIN_ROLE / owner) ---
GEBRID_ADMIN=0x0000000000000000000000000000000000000000

# --- Signing ---
# Preferred: do NOT set DEPLOYER_PRIVATE_KEY. Use a keystore or hardware wallet instead:
#   forge script script/DeployCore.s.sol:DeployCore --rpc-url base_sepolia \
#     --account gebrid-deployer --sender $GEBRID_ADMIN --broadcast --verify
# Testnet-only fallback (must correspond to GEBRID_ADMIN):
# DEPLOYER_PRIVATE_KEY=

# --- RPC ---
BASE_SEPOLIA_RPC_URL=
BASE_RPC_URL=

# --- Verification ---
ETHERSCAN_API_KEY=

# --- ERC-6551 registry (ADR-0002) ---
# Unset: bind the canonical singleton 0x000000006551c19487814612e58FE06813775758.
# The deploy script proves it is present and derives addresses per spec, and aborts otherwise.
# GEBRID_ERC6551_REGISTRY=
# Set to true only on a chain that genuinely has no singleton (or on anvil):
# GEBRID_DEPLOY_OWN_REGISTRY=false

# --- Admin handover delay, in seconds (default 3 days) ---
# GEBRID_ADMIN_TRANSFER_DELAY=259200

# --- Optional token metadata ---
GEBRID_NFT_NAME=GEBRID Agent
GEBRID_NFT_SYMBOL=GAGENT
